body {
    background-color: #fcf8f2;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    margin: 0;
    padding: 24px;
}

.header-container {
    max-width: 1400px;
    margin: 0 auto 24px auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.brand-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.brand-section h1 {
    margin: 0;
    font-size: 28px;
    color: #2c2724;
}

#game-count {
    font-size: 14px;
    background: #eadecf;
    padding: 3px 8px;
    border-radius: 12px;
    color: #706259;
}

.nav-btn {
    padding: 10px 18px;
    background-color: #2c2724;
    color: white;
    border: none;
    border-radius: 20px;
    cursor: pointer;
    font-weight: bold;
    font-size: 14px;
    transition: background 0.2s;
}

.nav-btn:hover {
    background-color: #4a3e3d;
}

#search-bar {
    width: 100%;
    box-sizing: border-box;
    padding: 14px 20px;
    font-size: 15px;
    border: none;
    border-radius: 24px;
    background-color: #f1e6da;
    color: #4a3e3d;
    outline: none;
}

.games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(115px, 1fr));
    gap: 14px;
    max-width: 1400px;
    margin: 0 auto;
}

.game-card {
    background-color: #eadecf;
    border-radius: 16px; /* Smooth aesthetic curvature matching your visual design */
    overflow: hidden;
    aspect-ratio: 1 / 1;
    cursor: pointer;
    box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.game-card:hover {
    transform: scale(1.05);
}

.game-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
